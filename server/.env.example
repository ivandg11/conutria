PORT=4000
NODE_ENV=development
DATABASE_URL="mysql://USER:PERCENT_ENCODED_PASSWORD@HOST:PORT/DATABASE?sslcert=ca.pem&sslaccept=strict"
JWT_SECRET=replace-with-a-long-random-secret
SUPERADMIN_EMAIL=admin@example.com

# Use Stripe test keys locally. Stripe CLI supplies the local signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLIENT_URL=https://your-domain.example

# Resend sender must be verified in your Resend account.
RESEND_API_KEY=
MAIL_FROM="Conutria <acceso@example.com>"

# For Aiven, place the downloaded CA certificate at server/prisma/ca.pem.
# Prisma resolves sslcert relative to server/prisma.
